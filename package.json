{
  "name": "pi-hole-for-lametric",
  "version": "2.0.0",
  "description": "Serves Pi-hole v6 stats as a LaMetric \"My Data DIY\" poll endpoint",
  "main": "index.js",
  "repository": "github:marsmichelmann/Pi-Hole-for-LaMetric",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node -e \"require('./index').main()\"",
    "test": "jest",
    "prettier": "prettier *.js",
    "prettier-check": "prettier --check *.js"
  },
  "author": "Markus Michel",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "babel-jest": "27.4.6",
    "babel-plugin-rewire": "1.2.0",
    "fetch-mock-jest": "1.5.1",
    "jest": "27.4.7",
    "jest-cli": "27.4.7",
    "prettier": "2.5.1"
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "text"
    ]
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 4,
    "singleQuote": true,
    "useTabs": true
  }
}
